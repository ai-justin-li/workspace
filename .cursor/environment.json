{
  "name": "SoCo Spa Reservation Tool",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "Mobile API",
      "command": "source .venv/bin/activate && uvicorn mobile_api:app --reload --host 0.0.0.0 --port 8000"
    },
    {
      "name": "Streamlit GUI",
      "command": "source .venv/bin/activate && streamlit run spa_booking_gui.py --server.address 0.0.0.0 --server.port 8501 --server.headless true"
    }
  ],
  "ports": [
    { "name": "Mobile API", "port": 8000 },
    { "name": "Streamlit GUI", "port": 8501 }
  ]
}
