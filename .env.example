# Twilio Configuration (get from https://www.twilio.com/console)
# You need a Twilio account, a phone number enabled for SMS, and the auth token.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_PHONE=+18435551212

# Google Calendar API (optional overrides)
# Download OAuth 2.0 Client ID credentials (Desktop app) as credentials.json
# Place credentials.json in the project directory (do not commit it)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_CALENDAR_ID=primary
